{
  "name": "river",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test && node --test scripts/lib/recovery.test.mjs",
    "setup:local": "node scripts/configure-local.mjs",
    "db:migrate:local": "pnpm --filter @river/web exec wrangler d1 migrations apply river-local --local",
    "test:documents": "node apps/documents/scripts/verify-container.mjs",
    "ci:build": "node scripts/cloudflare-build.mjs",
    "ci:deploy": "node scripts/cloudflare-deploy.mjs",
    "test:deployment": "node --test scripts/lib/deployment.test.mjs",
    "backup:staging": "node scripts/backup.mjs --staging",
    "backup:production": "node scripts/backup.mjs --production",
    "restore:drill": "node scripts/restore-drill.mjs",
    "backup:status": "node scripts/backup-status.mjs",
    "auth:mail": "node scripts/auth-mail.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "turbo": "2.10.12",
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.3",
    "vitest": "4.1.11"
  }
}
