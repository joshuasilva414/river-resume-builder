FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl fontconfig fonts-lmodern=2.005-1 && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic%400.17.0/tectonic-0.17.0-x86_64-unknown-linux-musl.tar.gz -o /tmp/tectonic.tar.gz \
 && echo '8533d07f9ccbd7a65824b9e0459041bca34af1eb33daba48f59215593753a3b7  /tmp/tectonic.tar.gz' | sha256sum -c - \
 && tar -xzf /tmp/tectonic.tar.gz -C /usr/local/bin tectonic && rm /tmp/tectonic.tar.gz
RUN npm install --global pnpm@10.33.0
# Pin and warm the compiler resources independently of application code changes.
ENV XDG_CACHE_HOME=/opt/tectonic-cache SOURCE_DATE_EPOCH=0
COPY apps/documents/resources/warmup.tex /tmp/warmup/resume.tex
COPY apps/documents/check-resources.mjs /tmp/check-resources.mjs
RUN mkdir -p /app /opt/tectonic-cache && cd /tmp/warmup \
 && timeout 600 tectonic -X compile --untrusted -Z deterministic-mode --keep-logs --outdir . resume.tex \
 && node /tmp/check-resources.mjs && rm -rf /tmp/warmup /tmp/check-resources.mjs
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/documents ./apps/documents
RUN pnpm install --frozen-lockfile --filter @river/documents... && pnpm --filter @river/documents exec node build.mjs
WORKDIR /app
RUN cp /workspace/apps/documents/dist/*.mjs /app/ && cp /workspace/apps/documents/server.mjs /app/server.mjs && cp /workspace/apps/documents/check-resources.mjs /app/check-resources.mjs \
 && ln -s /workspace/apps/documents/node_modules /app/node_modules
RUN rm -f /app/fixture.mjs /app/check-resources.mjs && chmod -R a+rX /opt/tectonic-cache
USER node
EXPOSE 8080
CMD ["node", "/app/server.mjs"]
