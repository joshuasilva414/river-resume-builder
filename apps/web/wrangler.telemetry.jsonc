{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "river-telemetry-local",
  "account_id": "a91c30d69981b341efe3b656a263f6da",
  "main": "src/server/security-telemetry.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "persist": true },
    "traces": { "enabled": false }
  },
  "env": {
    "staging": { "name": "river-telemetry-staging" },
    "production": { "name": "river-telemetry-production" }
  }
}
