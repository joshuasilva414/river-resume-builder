{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "river-local",
  "account_id": "a91c30d69981b341efe3b656a263f6da",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "persist": false },
    "traces": { "enabled": false }
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://127.0.0.1:3000",
    "ADMIN_EMAIL": "joshuasilva414@gmail.com",
    "ALLOWED_EMAILS": "",
    "EMAIL_FROM": "River <hello@river.jilva.dev>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "river-local",
      "database_id": "river-local",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "river-local-artifacts"
    }
  ],
  "workflows": [
    {
      "binding": "DOCUMENT_WORKFLOW",
      "name": "river-local-documents",
      "class_name": "DocumentWorkflow"
    },
    {
      "binding": "JOB_AI_WORKFLOW",
      "name": "river-local-job-analysis",
      "class_name": "JobAiWorkflow"
    },
    {
      "binding": "SCORING_WORKFLOW",
      "name": "river-local-scoring",
      "class_name": "ScoringWorkflow"
    },
    {
      "binding": "TEMPLATE_SCORING_WORKFLOW",
      "name": "river-local-template-scoring",
      "class_name": "TemplateScoringWorkflow"
    },
    {
      "binding": "BACKUP_WORKFLOW",
      "name": "river-local-backups",
      "class_name": "BackupWorkflow"
    },
    {
      "binding": "WORDING_WORKFLOW",
      "name": "river-local-wording",
      "class_name": "WordingWorkflow"
    },
    {
      "binding": "SOURCE_AI_WORKFLOW",
      "name": "river-local-source-claims",
      "class_name": "SourceAiWorkflow"
    },
    {
      "binding": "DUPLICATE_AI_WORKFLOW",
      "name": "river-local-duplicate-comparison",
      "class_name": "DuplicateAiWorkflow"
    },
    {
      "binding": "TEMPLATE_VALIDATION_WORKFLOW",
      "name": "river-local-template-validation",
      "class_name": "TemplateValidationWorkflow"
    },
    {
      "binding": "TEMPLATE_AI_WORKFLOW",
      "name": "river-local-template-ai",
      "class_name": "TemplateAiWorkflow"
    },
    {
      "binding": "SOURCE_REFINEMENT_WORKFLOW",
      "name": "river-local-source-refinement",
      "class_name": "SourceRefinementWorkflow"
    }
  ],
  "services": [
    {
      "binding": "DOCUMENTS",
      "service": "river-documents-local",
      "entrypoint": "DocumentService"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "env": {
    "staging": {
      "name": "river-staging",
      "tail_consumers": [{ "service": "river-telemetry-staging" }],
      "vars": {
        "ENVIRONMENT": "staging",
        "BACKUP_ACCOUNT_ID": "a91c30d69981b341efe3b656a263f6da",
        "BACKUP_DATABASE_ID": "1b837147-de99-4aaa-a4ad-386b826412b0",
        "BACKUP_BUCKET_NAME": "river-staging-artifacts",
        "APP_URL": "https://river-staging.jilva.workers.dev",
        "ATS_SCREENER_ORIGIN": "https://ats.jilva.dev",
        "ADMIN_EMAIL": "joshuasilva414@gmail.com",
        "ALLOWED_EMAILS": "jilvadev@gmail.com,karisamscott@gmail.com",
        "EMAIL_FROM": "River <hello@river.jilva.dev>"
      },
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "river-staging-artifacts"
        }
      ],
      "workflows": [
        {
          "binding": "DOCUMENT_WORKFLOW",
          "name": "river-staging-documents",
          "class_name": "DocumentWorkflow"
        },
        {
          "binding": "JOB_AI_WORKFLOW",
          "name": "river-staging-job-analysis",
          "class_name": "JobAiWorkflow"
        },
        {
          "binding": "SCORING_WORKFLOW",
          "name": "river-staging-scoring",
          "class_name": "ScoringWorkflow"
        },
        {
          "binding": "TEMPLATE_SCORING_WORKFLOW",
          "name": "river-staging-template-scoring",
          "class_name": "TemplateScoringWorkflow"
        },
        {
          "binding": "BACKUP_WORKFLOW",
          "name": "river-staging-backups",
          "class_name": "BackupWorkflow"
        },
        {
          "binding": "WORDING_WORKFLOW",
          "name": "river-staging-wording",
          "class_name": "WordingWorkflow"
        },
        {
          "binding": "SOURCE_AI_WORKFLOW",
          "name": "river-staging-source-claims",
          "class_name": "SourceAiWorkflow"
        },
        {
          "binding": "DUPLICATE_AI_WORKFLOW",
          "name": "river-staging-duplicate-comparison",
          "class_name": "DuplicateAiWorkflow"
        },
        {
          "binding": "TEMPLATE_VALIDATION_WORKFLOW",
          "name": "river-staging-template-validation",
          "class_name": "TemplateValidationWorkflow"
        },
        {
          "binding": "TEMPLATE_AI_WORKFLOW",
          "name": "river-staging-template-ai",
          "class_name": "TemplateAiWorkflow"
        },
        {
          "binding": "SOURCE_REFINEMENT_WORKFLOW",
          "name": "river-staging-source-refinement",
          "class_name": "SourceRefinementWorkflow"
        }
      ],
      "services": [
        {
          "binding": "DOCUMENTS",
          "service": "river-documents-staging",
          "entrypoint": "DocumentService"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["hello@river.jilva.dev"]
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "river-staging",
          "database_id": "1b837147-de99-4aaa-a4ad-386b826412b0",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "production": {
      "name": "river-production",
      "tail_consumers": [{ "service": "river-telemetry-production" }],
      "vars": {
        "ENVIRONMENT": "production",
        "BACKUP_ACCOUNT_ID": "a91c30d69981b341efe3b656a263f6da",
        "BACKUP_DATABASE_ID": "50d255b8-840b-4d03-87d9-c3fb9e810366",
        "BACKUP_BUCKET_NAME": "river-production-artifacts",
        "APP_URL": "https://river.jilva.dev",
        "ATS_SCREENER_ORIGIN": "https://ats.jilva.dev",
        "ADMIN_EMAIL": "joshuasilva414@gmail.com",
        "ALLOWED_EMAILS": "jilvadev@gmail.com,karisamscott@gmail.com",
        "EMAIL_FROM": "River <hello@river.jilva.dev>"
      },
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "river-production-artifacts"
        }
      ],
      "workflows": [
        {
          "binding": "DOCUMENT_WORKFLOW",
          "name": "river-production-documents",
          "class_name": "DocumentWorkflow"
        },
        {
          "binding": "JOB_AI_WORKFLOW",
          "name": "river-production-job-analysis",
          "class_name": "JobAiWorkflow"
        },
        {
          "binding": "SCORING_WORKFLOW",
          "name": "river-production-scoring",
          "class_name": "ScoringWorkflow"
        },
        {
          "binding": "TEMPLATE_SCORING_WORKFLOW",
          "name": "river-production-template-scoring",
          "class_name": "TemplateScoringWorkflow"
        },
        {
          "binding": "BACKUP_WORKFLOW",
          "name": "river-production-backups",
          "class_name": "BackupWorkflow"
        },
        {
          "binding": "WORDING_WORKFLOW",
          "name": "river-production-wording",
          "class_name": "WordingWorkflow"
        },
        {
          "binding": "SOURCE_AI_WORKFLOW",
          "name": "river-production-source-claims",
          "class_name": "SourceAiWorkflow"
        },
        {
          "binding": "DUPLICATE_AI_WORKFLOW",
          "name": "river-production-duplicate-comparison",
          "class_name": "DuplicateAiWorkflow"
        },
        {
          "binding": "TEMPLATE_VALIDATION_WORKFLOW",
          "name": "river-production-template-validation",
          "class_name": "TemplateValidationWorkflow"
        },
        {
          "binding": "TEMPLATE_AI_WORKFLOW",
          "name": "river-production-template-ai",
          "class_name": "TemplateAiWorkflow"
        },
        {
          "binding": "SOURCE_REFINEMENT_WORKFLOW",
          "name": "river-production-source-refinement",
          "class_name": "SourceRefinementWorkflow"
        }
      ],
      "services": [
        {
          "binding": "DOCUMENTS",
          "service": "river-documents-production",
          "entrypoint": "DocumentService"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["hello@river.jilva.dev"]
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "river-production",
          "database_id": "50d255b8-840b-4d03-87d9-c3fb9e810366",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "river.jilva.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
