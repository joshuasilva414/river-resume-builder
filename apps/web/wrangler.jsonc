{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "river-local",
  "account_id": "a91c30d69981b341efe3b656a263f6da",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "persist": false
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://127.0.0.1:3000",
    "ADMIN_EMAIL": "joshuasilva414@gmail.com",
    "ALLOWED_EMAILS": "",
    "EMAIL_FROM": "River <hello@river.jilva.dev>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "river-local",
      "database_id": "river-local",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "river-local-artifacts"
    }
  ],
  "workflows": [
    {
      "binding": "BACKUP_WORKFLOW",
      "name": "river-local-backups",
      "class_name": "BackupWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "river-staging",
      "tail_consumers": [
        {
          "service": "river-telemetry-staging"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "BACKUP_ACCOUNT_ID": "a91c30d69981b341efe3b656a263f6da",
        "BACKUP_DATABASE_ID": "1b837147-de99-4aaa-a4ad-386b826412b0",
        "BACKUP_BUCKET_NAME": "river-staging-artifacts",
        "APP_URL": "https://river-staging.jilva.workers.dev",
        "ATS_SCREENER_ORIGIN": "https://ats.jilva.dev",
        "ADMIN_EMAIL": "joshuasilva414@gmail.com",
        "ALLOWED_EMAILS": "jilvadev@gmail.com,karisamscott@gmail.com",
        "EMAIL_FROM": "River <hello@river.jilva.dev>"
      },
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "river-staging-artifacts"
        }
      ],
      "workflows": [
        {
          "binding": "BACKUP_WORKFLOW",
          "name": "river-staging-backups",
          "class_name": "BackupWorkflow"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "hello@river.jilva.dev"
          ]
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "river-staging",
          "database_id": "1b837147-de99-4aaa-a4ad-386b826412b0",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "production": {
      "name": "river-production",
      "tail_consumers": [
        {
          "service": "river-telemetry-production"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "BACKUP_ACCOUNT_ID": "a91c30d69981b341efe3b656a263f6da",
        "BACKUP_DATABASE_ID": "50d255b8-840b-4d03-87d9-c3fb9e810366",
        "BACKUP_BUCKET_NAME": "river-production-artifacts",
        "APP_URL": "https://river.jilva.dev",
        "ATS_SCREENER_ORIGIN": "https://ats.jilva.dev",
        "ADMIN_EMAIL": "joshuasilva414@gmail.com",
        "ALLOWED_EMAILS": "jilvadev@gmail.com,karisamscott@gmail.com",
        "EMAIL_FROM": "River <hello@river.jilva.dev>"
      },
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "river-production-artifacts"
        }
      ],
      "workflows": [
        {
          "binding": "BACKUP_WORKFLOW",
          "name": "river-production-backups",
          "class_name": "BackupWorkflow"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "hello@river.jilva.dev"
          ]
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "river-production",
          "database_id": "50d255b8-840b-4d03-87d9-c3fb9e810366",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "river.jilva.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
